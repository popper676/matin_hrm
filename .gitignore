# ============================================================
#  HRM React — .gitignore
#  Maintained by: Engineering Team
# ============================================================

# ── Node / npm ───────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity

# ── Environment / Secrets ────────────────────────────────────
.env
.env.*
!.env.example
env.yaml
!env.yaml.example

# SSH & GCP Keys — NEVER commit private keys
gcp_actions_key
gcp_actions_key.pub
deploy_key
deploy_key.pub
*.pem
*.key
id_rsa
id_ed25519

# ── Databases ────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Data & Spreadsheet Files ─────────────────────────────────
# These may contain real customer PII — never commit
*.xlsx
*.xls
*.csv
parsed_costing.json
kpi_settings.json

# ── Log & Temp Files ─────────────────────────────────────────
*.log
deploy_logs.txt
job_logs.txt
runs.json
response.txt
payload.json

# ── OS / IDE ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/

# ── Build Output ─────────────────────────────────────────────
hrm-client/dist/
hrm-client/build/

# ── Scratch / One-off Scripts ────────────────────────────────
# Utility and debug scripts that should not be part of the codebase
scratch/

# ── Archive ──────────────────────────────────────────────────
Legacy_Python_Scripts_Archive/

# HR runtime data and local credentials
.ssh_temp/
server/uploads/*
!server/uploads/.gitkeep
hrm-client/public/generated_docs/
*.dump
*.backup
*.sql.gz
playwright-report/
test-results/

access-browser-artifacts/

# Generated demo credentials and recovery manifests (local only)
server/demo-private/
