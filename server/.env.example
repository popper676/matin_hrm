PORT=8080
NODE_ENV=development
# Use only a NEW Supabase project. Never copy the former client's .env.
SUPABASE_URL=https://NEW_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=NEW_PROJECT_SERVICE_ROLE_KEY
EXPECTED_SUPABASE_PROJECT_REF=NEW_PROJECT_REF
# Returned by supabase/001_fresh_hr_schema.sql:
HR_INSTANCE_ID=
# Generate a fresh value: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
FRONTEND_ONBOARDING_URL=http://localhost:5173
# Optional HR integrations: leave empty until configured for THIS instance.
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BIOMETRIC_API_KEY=
# Optional recruiting announcements (not customer messaging):
ZERNIO_API_KEY=
ZERNIO_FACEBOOK_ACCOUNT_ID=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Optional recruitment email:
EMAIL_USER=
EMAIL_PASS=
